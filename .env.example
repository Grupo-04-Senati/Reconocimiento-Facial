# === Backend Environment Variables ===

# Supabase (local development)
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=<supabase-local-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<supabase-local-service-role-key>
SUPABASE_STORAGE_BUCKET=face-images

# Database (local)
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# For production, use cloud credentials:
# SUPABASE_URL=https://xxxxx.supabase.co
# SUPABASE_ANON_KEY=eyJ...
# SUPABASE_SERVICE_ROLE_KEY=eyJ...
# DATABASE_URL=postgresql://postgres:[PASS]@db.xxxxx.supabase.co:5432/postgres

# Security
JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# IA / ML
FACE_MODEL_PATH=./models/arcface.onnx
ML_MODEL_PATH=./models/probability_model.joblib
UMBRAL_SIMILITUD=0.75

# App
ENVIRONMENT=development
LOG_LEVEL=INFO

# === Frontend Environment Variables (VITE_ prefix) ===
# VITE_SUPABASE_URL=http://localhost:54321
# VITE_SUPABASE_ANON_KEY=<supabase-local-anon-key>
# VITE_API_BASE_URL=http://localhost:8000
